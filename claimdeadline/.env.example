# Postgres from Vercel Marketplace (Neon). Either name works.
DATABASE_URL=
POSTGRES_URL=

# Bearer token for /api/admin/*
ADMIN_TOKEN=

# Resend. AUDIENCE_ID is the audience id, or a segment id if audiences have moved.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=ClaimDeadline <onboarding@resend.dev>

# Sponsor inquiries are emailed here.
OWNER_EMAIL=

# Canonical site URL for links, sitemap, and the weekly email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional line in the rendered Monday email.
WEEKLY_SPONSOR_NAME=
WEEKLY_SPONSOR_URL=
